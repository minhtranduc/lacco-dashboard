MYSQL_HOST=localhost
MYSQL_PORT=3306
# Tài khoản APP RUNTIME (Streamlit) — bước 7.1 Fix B: tách khỏi tài khoản
# migration, least-privilege (chỉ SELECT/INSERT/UPDATE/DELETE trên schema
# `lacco`, KHÔNG có CREATE/ALTER/DROP). KHÔNG dùng `root`/tài khoản có
# GRANT OPTION cho biến này (xem docs/architecture/SDD.md hoặc báo cáo
# bước 7.1 để biết câu lệnh SQL tạo user least-privilege tương ứng).
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=lacco

# Tài khoản MIGRATION (Alembic, `migrations/env.py`) — cần thêm
# CREATE/ALTER/DROP/INDEX/REFERENCES trên schema `lacco` mà tài khoản app
# runtime ở trên KHÔNG có. Nếu để trống, `migrations/env.py` fallback dùng
# lại MYSQL_USER/MYSQL_PASSWORD ở trên (tương thích ngược) — NHƯNG khi đó
# tài khoản app runtime sẽ cần thêm quyền DDL, mất tác dụng tách quyền.
# Khuyến nghị luôn đặt 2 biến này với 1 user MySQL riêng, chỉ dùng khi chạy
# `alembic upgrade head`, không dùng cho app runtime hằng ngày.
MIGRATE_MYSQL_USER=your_mysql_migrate_user
MIGRATE_MYSQL_PASSWORD=your_mysql_migrate_password

# Sentry DSN giám sát lỗi runtime (bước 6.3, HD-20). Lấy tại sentry.io ->
# project Settings -> Client Keys (DSN). Để trống nếu chưa cấu hình — app
# vẫn chạy bình thường, chỉ bỏ qua giám sát lỗi (xem src/services/config.py
# và src/services/monitoring.py).
SENTRY_DSN=
# Môi trường hiện tại, gửi kèm mỗi event lên Sentry để phân biệt
# development/production. Mặc định "development" nếu để trống.
APP_ENVIRONMENT=development

# Cookie key ký cookie phiên đăng nhập (streamlit-authenticator, bước 7.1).
# Sinh bằng: python -c "import secrets; print(secrets.token_hex(32))"
# BẮT BUỘC đặt giá trị thật trước khi deploy production (bước 7.2) — nếu
# APP_ENVIRONMENT=production mà thiếu biến này, app sẽ từ chối khởi động
# (xem src/auth/authentication.py::_cookie_key()). Để trống ở dev/demo vẫn
# chạy được (tự sinh ngẫu nhiên mỗi lần restart, cookie mất hiệu lực khi
# restart — chấp nhận được ngoài production).
AUTH_COOKIE_KEY=
